{
  "name": "clubsmaker-backend",
  "version": "1.0.0",
  "type": "module",
  "description": "Backend para sistema ClubsMaker com IA",
  "main": "server.js",
  "engines": {
    "node": ">=18.0.0"
  },
  "scripts": {
    "start": "node server.js",
    "dev": "node -r dotenv/config --watch server.js",
    "worker": "node workers/cronJobs.js",
    "worker:bull": "node workers/bullQueue.js",
    "dev:all": "concurrently \"npm run dev\" \"npm run worker\""
  },
  "dependencies": {
    "axios": "^1.13.2",
    "bcryptjs": "^2.4.3",
    "bull": "^4.16.5",
    "cloudinary": "^2.10.0",
    "cors": "^2.8.5",
    "dotenv": "^17.2.3",
    "express": "^4.18.2",
    "jsonwebtoken": "^9.0.2",
    "knex": "^3.1.0",
    "mercadopago": "^2.12.0",
    "node-cron": "^4.2.1",
    "nodemailer": "^8.0.1",
    "openai": "^6.9.1",
    "pdfkit": "^0.17.2",
    "pg": "^8.16.3",
    "redis": "^4.7.1",
    "sqlite3": "^5.1.7"
  },
  "devDependencies": {
    "concurrently": "^9.2.1"
  }
}
